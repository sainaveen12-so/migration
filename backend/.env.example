# Application
DEBUG=false
SECRET_KEY=change-me-in-production-use-strong-secret-key-at-least-32-chars

# Database (SQLite)
DATA_DIR=./data
DATABASE_URL=sqlite+aiosqlite:///./data/migration.db
DATABASE_URL_SYNC=sqlite:///./data/migration.db

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Providers
DEFAULT_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=500

# Email
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@migration-tool.com
FRONTEND_URL=http://localhost:3000

# GitHub
GITHUB_TOKEN=
